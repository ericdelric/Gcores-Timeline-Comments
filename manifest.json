{
  "manifest_version": 3,
  "name": "机核时间轴评论标记",
  "version": "1.1.3",
  "description": "在机核电台官方时间轴上显示带时间戳的评论，悬停预览，点击跳转。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.gcores.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.gcores.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.gcores.com/*"
      ],
      "js": [
        "src/lib.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
